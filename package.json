{
  "name": "reserva-simple",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.prod.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only -P tsconfig.prod.json src/server.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test-mail": "node mailer.test.js",
    "test-sandbox": "node mailer.sandbox.test.js"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "lodash-es": "^4.18.1",
    "lowdb": "^3.0.0",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.4.2",
    "@types/nodemailer": "^8.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": "18.x"
  }
}
